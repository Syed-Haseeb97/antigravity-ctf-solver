# Antigravity CLI — credentials
# Copy to .env and fill in your keys.

# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Provider-specific (optional, for Bedrock/Azure/Zen fallback)
AWS_REGION=us-east-1
AWS_BEARER_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENCODE_ZEN_API_KEY=

# Infra
SANDBOX_IMAGE=ctf-sandbox
MAX_CONCURRENT_CHALLENGES=10
MAX_ATTEMPTS_PER_CHALLENGE=3
CONTAINER_MEMORY_LIMIT=16g